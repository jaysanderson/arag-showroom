# ARAG Showroom does not talk to Progress Agentic RAG at all — it has no Knowledge Box and
# never calls ARAG_* configuration, unlike the three products it showcases. There is nothing
# ARAG-related to set here.

# ── Service ────────────────────────────────────────────────────────────────────
PORT=8080                          # listen port
HOST=0.0.0.0
NODE_ENV=development               # development | production — production requires SHOWROOM_SESSION_SECRET
LOG_LEVEL=info                     # debug | info | warn | error
DATA_DIR=./data                    # JSON store: users, invites, audit log, access requests (NOT content)
PUBLIC_URL=http://localhost:8080   # absolute base URL, used to build invitation links

# ── Showroom identity and bootstrap ─────────────────────────────────────────────
# Signs every session cookie (HMAC-SHA256). Must stay stable across restarts/deploys — changing
# it signs everyone out. Required (>=16 chars) in production; generate: openssl rand -hex 32
SHOWROOM_SESSION_SECRET=

# Create the one bootstrap administrator on first boot, only while the user store is empty.
# Set both before the very first run against a fresh DATA_DIR, or there is no way to sign in.
SHOWROOM_ADMIN_EMAIL=
SHOWROOM_ADMIN_PASSWORD=

# 1 = show each product's live demo URL on its public marketing page. 0 (default) keeps demo
# links visible only inside the gated portal, to whoever has the `demo` surface for that product.
SHOWROOM_PUBLIC_DEMO_LINKS=0

# ── Per-product admin tokens ─────────────────────────────────────────────────────
# Each product's OWN ADMIN_TOKEN from its OWN deployment (copy from that product's Fly secrets).
# Shown, per product, only to a user whose role includes that product's `admin` surface. These
# are unrelated to this repo's own ADMIN_TOKEN below.
SHOWROOM_ADMIN_TOKEN_DOC_PROCESSING=
SHOWROOM_ADMIN_TOKEN_CALL_ANALYSIS=
SHOWROOM_ADMIN_TOKEN_VOICEBRIDGE=

# ── White-label branding (optional) ─────────────────────────────────────────────
# The portal rebrands itself from these, exactly as each accelerator does. Served, redacted of
# nothing because none of it is secret, at GET /api/v1/branding.
#BRAND_PRODUCT_NAME=Progress Agentic RAG Partner Accelerators
#BRAND_TAGLINE=Open-source reference products for the Progress Agentic RAG partner network.
#BRAND_LOGO_URL=/branding/logo.svg   # drop the file into DATA_DIR/branding/
#BRAND_PRIMARY_COLOR=                # any CSS colour; empty = platform default
#BRAND_ACCENT_COLOR=
#BRAND_POWERED_BY=1                  # 0 hides the "built on Progress Agentic RAG" credit
#BRAND_FOOTER_TEXT=
#BRAND_DOCS_URL=/api/v1/docs
#BRAND_SUPPORT_URL=

# ── Per-product URL overrides (optional) ────────────────────────────────────────
# Override the demoUrl/adminUrl baked into config/products.json for this deployment. Leave unset
# to use the values already in config/products.json.
#SHOWROOM_DEMO_URL_DOC_PROCESSING=
#SHOWROOM_ADMIN_URL_DOC_PROCESSING=
#SHOWROOM_DEMO_URL_CALL_ANALYSIS=
#SHOWROOM_ADMIN_URL_CALL_ANALYSIS=
#SHOWROOM_DEMO_URL_VOICEBRIDGE=
#SHOWROOM_ADMIN_URL_VOICEBRIDGE=

# ── Security (platform defaults, inherited from vendor/arag-platform) ───────────
# Break-glass operator credential for /api/v1/admin/* ONLY (health, config, usage, logs) — never
# the HTML /admin pages, never able to create or change a user. Every use is audited. Unset =
# that break-glass path is disabled (403); the showroom's own admin UI still works via user roles.
# generate: openssl rand -hex 24
ADMIN_TOKEN=
API_KEYS=                          # comma-separated; only matters for routes marked auth:"api" (none currently in this product)
ALLOWED_ORIGINS=                   # comma-separated CORS origins; empty = same-origin only
# Sized for a page view, not a single API call: one documentation page pulls a stylesheet, a
# script and up to ~15 screenshots. fly.toml uses the same numbers.
RATE_LIMIT_RPS=20                  # per-IP/per-key token-bucket rate limit
RATE_LIMIT_BURST=80
MAX_BODY_BYTES=26214400            # request body size cap (form posts, uploads)
TRUST_PROXY=fly                    # fly (trust Fly-Client-IP) | xff (trust first X-Forwarded-For) | none
